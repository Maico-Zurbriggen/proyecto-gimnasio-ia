APP_ENV=test
API_HOST=127.0.0.1
API_PORT=8000

# Neon Test con el rol restringido del servicio IA. Necesita USAGE + SELECT/INSERT/UPDATE
# sobre el schema ai_integration (ai_generation_requests/_attempts/_results/_result_validations)
# -- confirmado que existe con ese nombre y esas columnas. El rol backend_test NO tiene acceso
# a ese schema (es de la app, no del servicio de IA); usar el rol correcto, no ese.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Backend -> servicio IA. El backend manda esta clave en el header X-API-Key en cada
# request. Una sola clave por deployment -- test y producción usan secretos distintos
# porque son deployments de Vercel distintos, no porque este proceso los distinga.
# Sin configurar, la API responde 500 a todo (falla cerrado, no abierto).
AI_SERVICE_API_KEY=

# Servicio IA -> LLM. "ollama" (Cloudflare Tunnel, sin acceso a PostgreSQL) o "openai".
LLM_PROVIDER=ollama

# LLM_API_URL/LLM_API_TOKEN/LLM_MODEL: mismos nombres que ya estan provisionados para el
# tunel de Ollama (Cloudflare Tunnel + Bearer) -- no LLM_API_KEY/OLLAMA_MODEL.
LLM_API_URL=https://REPLACE_WITH_LLM_DOMAIN.example.com
LLM_API_TOKEN=
LLM_MODEL=qwen2.5:7b-instruct
LLM_CONFIGURATION_VERSION=generative/generar-rutina@1

# Solo si LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GENERATION_TIMEOUT_SECONDS=120
GENERATION_MAX_RETRIES=1
FAILED_RESULT_RETENTION_DAYS=30
POLLER_INTERVAL_SECONDS=2
