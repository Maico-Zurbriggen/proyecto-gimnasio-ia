APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL local con el rol restringido, creado por Backend/prisma/local-ai-role.sql.
DATABASE_URL=postgresql://gym_ai_local@127.0.0.1:55432/gym_local

# Backend -> servicio IA. Configurar un valor distinto por deployment de Vercel.
AI_SERVICE_API_KEY=

# Despliegue: vercel. Desarrollo local: local junto con APP_ENV=local.
GENERATION_QUEUE_MODE=local
# Cola durable. Usar la misma región en productor y consumidor.
QUEUE_REGION=gru1

# Servicio IA/Vercel -> API autenticada de Ollama en el Polo.
LLM_API_URL=https://yen-entrench-grader.ngrok-free.dev/polo
# Configurar con POLO_API_TOKEN; es distinto de VIVAZ_API_KEY.
LLM_API_TOKEN=
LLM_MODEL=qwen3.5:9b
LLM_CONFIGURATION_VERSION=generative/generar-rutina@10

GENERATION_TIMEOUT_SECONDS=120
GENERATION_MAX_RETRIES=1
