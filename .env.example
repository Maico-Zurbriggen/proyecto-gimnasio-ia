APP_ENV=test
API_HOST=127.0.0.1
API_PORT=8000

# Neon Test con el rol restringido del servicio IA.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Backend -> servicio IA. Configurar un valor distinto por deployment de Vercel.
AI_SERVICE_API_KEY=

# Cola durable. Usar la misma región en productor y consumidor.
QUEUE_REGION=gru1

# Servicio IA/Vercel -> Ollama/Polo mediante un endpoint HTTPS de ngrok protegido.
LLM_API_URL=https://REPLACE_WITH_STABLE_DOMAIN.ngrok.app
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASIC_AUTH_USERNAME=
LLM_BASIC_AUTH_PASSWORD=
LLM_CONFIGURATION_VERSION=generative/generar-rutina@1

GENERATION_TIMEOUT_SECONDS=120
GENERATION_MAX_RETRIES=1
